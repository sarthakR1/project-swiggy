pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    tools {
        jdk 'jdk21'
        nodejs 'node20'
    }

    environment {
        SCANNER_HOME  = tool 'sonar-scanner'
        IMAGE_REPO    = 'sarthakr1/swiggy'
        IMAGE_TAG     = "${BUILD_NUMBER}"
        NODE1_IP      = '10.0.1.77'
        NODE3_IP      = '10.0.1.40'
        SNS_TOPIC_ARN = 'arn:aws:sns:ap-south-1:176938213994:jenkins-pipeline-notifications'
        AWS_REGION    = 'ap-south-1'
        NODE_OPTIONS  = "--max-old-space-size=512"
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                git(
                    branch: 'main',
                    credentialsId: 'github-cred',
                    url: 'https://github.com/sarthakR1/project-swiggy.git'
                )
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                        $SCANNER_HOME/bin/sonar-scanner \
                          -Dsonar.projectName=Swiggy \
                          -Dsonar.projectKey=Swiggy \
                          -Dsonar.exclusions="node_modules/**,build/**,**/node_modules/**,**/build/**"
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_KEY')]) {
                    dependencyCheck(
                        odcInstallation: 'dependency-check',
                        additionalArguments: '''
                            --nvdApiKey ${NVD_KEY} 
                            --data /var/lib/jenkins/dependency-check-data
                            --format HTML 
                            --format XML 
                            --exclude "**/node_modules/**" 
                            --exclude "**/target/**" 
                            --exclude "**/dist/**" 
                            --exclude "**/.git/**" 
                            --disableAssembly 
                            --disableNodeJS
                        '''.stripIndent().replaceAll("\n", " ")
                    )
                }
            }
            post {
                always {
                    dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''
                    trivy fs \
                      --scanners vuln \
                      --severity HIGH,CRITICAL \
                      --ignore-unfixed \
                      --exit-code 0 \
                      . | tee trivyfs.txt
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                      -t ${IMAGE_REPO}:${IMAGE_TAG} \
                      -t ${IMAGE_REPO}:latest .
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    trivy image \
                      --severity HIGH,CRITICAL \
                      --ignore-unfixed \
                      --exit-code 0 \
                      ${IMAGE_REPO}:${IMAGE_TAG} | tee trivy.txt
                '''
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh '''
                            echo "${DOCKER_PASS}" | docker login -u "${DOCKER_USER}" --password-stdin
                            docker push ${IMAGE_REPO}:${IMAGE_TAG}
                            docker push ${IMAGE_REPO}:latest
                        '''
                    }
                }
            }
        }

        stage('Deploy Application & Metrics (Node 1)') {
            steps {
                script {
                    sshagent(credentials: ['aws-ssh-key']) {
                        sh """
                            ssh -o StrictHostKeyChecking=no ubuntu@${NODE1_IP} '
                                # 1. Clean & Deploy Swiggy App
                                docker system prune -af &&
                                docker pull ${IMAGE_REPO}:${IMAGE_TAG} &&
                                docker rm -f swiggy || true &&
                                docker run -d --name swiggy --restart unless-stopped -p 3000:3000 ${IMAGE_REPO}:${IMAGE_TAG} &&
                                
                                # 2. Deploy Node Exporter (Server Hardware Metrics)
                                docker rm -f node-exporter || true &&
                                docker run -d --name node-exporter --restart unless-stopped -p 9100:9100 prom/node-exporter &&
                                
                                # 3. Deploy cAdvisor (Container Metrics)
                                docker rm -f cadvisor || true &&
                                docker run -d --name cadvisor --restart unless-stopped -p 8080:8080 \\
                                  -v /:/rootfs:ro -v /var/run:/var/run:ro -v /sys:/sys:ro -v /var/lib/docker/:/var/lib/docker:ro \\
                                  gcr.io/cadvisor/cadvisor:latest
                            '
                        """
                    }
                }
            }
        }

        stage('Configure Monitoring Stack (Node 3)') {
            steps {
                script {
                    sshagent(credentials: ['aws-ssh-key']) {
                        sh """
                            ssh -o StrictHostKeyChecking=no ubuntu@${NODE3_IP} '
                                # Generate Prometheus configuration targeting Node 1
                                cat << EOF > /home/ubuntu/prometheus.yml
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: "node1-swiggy-server"
    static_configs:
      - targets: ["${NODE1_IP}:9100", "${NODE1_IP}:8080"]
EOF

                                # Run Prometheus
                                docker rm -f prometheus || true
                                docker run -d --name prometheus --restart unless-stopped \\
                                  -p 9090:9090 \\
                                  -v /home/ubuntu/prometheus.yml:/etc/prometheus/prometheus.yml \\
                                  prom/prometheus

                                # Run Grafana
                                docker rm -f grafana || true
                                docker run -d --name grafana --restart unless-stopped \\
                                  -p 3000:3000 \\
                                  grafana/grafana
                            '
                        """
                    }
                }
            }
        }
    }

    post {
    success {
        sh '''
            aws sns publish \
              --topic-arn "arn:aws:sns:ap-south-1:176938213994:jenkins-pipeline-notifications" \
              --subject "BUILD SUCCESS: Swiggy Pipeline #${BUILD_NUMBER}" \
              --message "Pipeline completed successfully for build #${BUILD_NUMBER}. Deployment on Node 1 is live." \
              --region "ap-south-1"
        '''
    }
    failure {
        sh '''
            aws sns publish \
              --topic-arn "arn:aws:sns:ap-south-1:176938213994:jenkins-pipeline-notifications" \
              --subject "BUILD FAILED: Swiggy Pipeline #${BUILD_NUMBER}" \
              --message "Pipeline failed during build #${BUILD_NUMBER}. Please check Jenkins console logs." \
              --region "ap-south-1"
        '''
    }
}
