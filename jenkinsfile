pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    tools {
        jdk 'jdk21'
        nodejs 'node20'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        IMAGE_REPO = 'sarthakr1/swiggy'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                git(
                    branch: 'main',
                    credentialsId: 'github-cred',
                    url: 'https://github.com/sarthakR1/project-swiggy.git'
                )
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                        $SCANNER_HOME/bin/sonar-scanner \
                          -Dsonar.projectName=Swiggy \
                          -Dsonar.projectKey=Swiggy \
                          -Dsonar.exclusions="node_modules/**,build/**,**/node_modules/**,**/build/**"
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
stage('OWASP Dependency Check') {
            steps {
                withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_KEY')]) {
                    dependencyCheck(
                        odcInstallation: 'dependency-check',
                        additionalArguments: '''
                            --nvdApiKey ${NVD_KEY} 
                            --data /var/lib/jenkins/dependency-check-data
                            --format HTML 
                            --format XML 
                            --exclude "**/node_modules/**" 
                            --exclude "**/target/**" 
                            --exclude "**/dist/**" 
                            --exclude "**/.git/**" 
                            --disableAssembly 
                            --disableNodeJS
                        '''.stripIndent().replaceAll("\n", " ")
                    )
                }
            }
            post {
                always {
                    dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''
                    trivy fs \
                      --scanners vuln \
                      --severity HIGH,CRITICAL \
                      --ignore-unfixed \
                      --exit-code 1 \
                      . | tee trivyfs.txt
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                      -t ${IMAGE_REPO}:${IMAGE_TAG} \
                      -t ${IMAGE_REPO}:latest .
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    trivy image \
                      --severity HIGH,CRITICAL \
                      --ignore-unfixed \
                      --exit-code 1 \
                      ${IMAGE_REPO}:${IMAGE_TAG} | tee trivy.txt
                '''
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh '''
                            echo "${DOCKER_PASS}" | docker login -u "${DOCKER_USER}" --password-stdin
                            docker push ${IMAGE_REPO}:${IMAGE_TAG}
                            docker push ${IMAGE_REPO}:latest
                        '''
                    }
                }
            }
        }

        stage('Deploy (Node 1)') {
            steps {
                script {
                    def appServerIp = '10.0.1.77' // Update to your Node 1 private IP if different

                    sshagent(credentials: ['aws-ssh-key']) {
                        sh """
                            ssh -o StrictHostKeyChecking=no ubuntu@\${appServerIp} '
                                docker system prune -af &&
                                docker pull ${IMAGE_REPO}:${IMAGE_TAG} &&
                                docker rm -f swiggy || true &&
                                docker run -d \\
                                  --name swiggy \\
                                  --restart unless-stopped \\
                                  -p 3000:3000 \\
                                  ${IMAGE_REPO}:${IMAGE_TAG} &&
                                echo "Waiting for application to boot..." &&
                                for i in \$(seq 1 10); do
                                    if curl -sf http://localhost:3000 > /dev/null; then
                                        echo "Health check passed!"
                                        exit 0
                                    fi
                                    echo "Attempt \$i failed, retrying in 3 seconds..."
                                    sleep 3
                                done
                                echo "Health check timed out after 30 seconds!"
                                exit 1
                            '
                        """
                    }
                }
            }
        }

        stage('Configure Monitoring (Node 3)') {
            steps {
                script {
                    def monitoringServerIp = '10.0.1.40' // Replace with your Node 3 private IP

                    sshagent(credentials: ['aws-ssh-key']) {
                        sh """
                            ssh -o StrictHostKeyChecking=no ubuntu@\${monitoringServerIp} '
                                wget https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb &&
                                sudo dpkg -i -E ./amazon-cloudwatch-agent.deb &&
                                
                                cat << "CONFIG_EOF" > config.json
                                {
                                    "agent": {
                                        "metrics_collection_interval": 60,
                                        "run_as_user": "root"
                                    },
                                    "metrics": {
                                        "metrics_collected": {
                                            "cpu": {
                                                "measurement": [
                                                    "cpu_usage_idle",
                                                    "cpu_usage_iowait",
                                                    "cpu_usage_user",
                                                    "cpu_usage_system"
                                                ],
                                                "metrics_collection_interval": 60,
                                                "totalcpu": false
                                            }
                                        }
                                    }
                                }
                                CONFIG_EOF

                                sudo /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:config.json
                            '
                        """
                    }
                }
            }
        }
    }
}
